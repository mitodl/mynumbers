{
  "name": "arythmix",
  "version": "0.2.0",
  "description": "Arithmetic puzzle game: combine given numbers to reach a target.",
  "main": "dist/server/server.js",
  "module": "./dist/lib/arithmix.es.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/arithmix.es.js",
      "require": "./dist/lib/arithmix.umd.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && webpack --config webpack.config.js",
    "build:server": "tsc",
    "build:client": "tsc -p tsconfig.client.json && webpack --config webpack.config.js",
    "build:lib": "vite build",
    "prepare": "vite build",
    "start": "node dist/server/server.js",
    "dev": "tsc && tsc -p tsconfig.client.json && webpack --config webpack.config.js --mode development && node --watch dist/server/server.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^6.0.1"
  }
}
